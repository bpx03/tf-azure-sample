# Terraform state files — NEVER commit
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Environment-specific secrets (if you split tfvars)
*.auto.tfvars
*.tfvars.json

# Exception: our committed tfvars (non-sensitive defaults)
!environments/*/terraform.tfvars

# Override files (local-only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
